# Used by `npm run dev` (loaded via dotenv in src/server.ts).
# When running fully in Docker Compose, this file is NOT used — compose
# injects DB_* from the project-root .env instead.

NODE_ENV=development
PORT=4000

# Must match what Postgres was initialized with (see project-root .env).
DB_HOST=localhost
DB_PORT=5432
DB_USER=Postgres
DB_PASS=Sophat676869
DB_NAME=airplane_attack

JWT_SECRET=replace_with_long_random_string
CORS_ORIGIN=http://localhost:5173
