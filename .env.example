# Copy this file to `.env` and adjust values before running `docker compose up`.
# Docker Compose reads `.env` (not `.env.example`) for variable substitution.

# Postgres — these are used by the postgres container AND injected into backend
POSTGRES_USER=Postgres
POSTGRES_PASSWORD=Sophat676869
POSTGRES_DB=airplane_attack

# Backend
JWT_SECRET=replace_with_long_random_string
CORS_ORIGIN=http://localhost

# Frontend (used at build time by Vite)
VITE_API_URL=http://localhost/api
VITE_WS_URL=ws://localhost/ws
